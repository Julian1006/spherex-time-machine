# Cached IRSA TAP responses: ~157 MB, rebuilt automatically on the next run
data/weekcache/

# Per-process index shards from parallel builds; merge.py folds these into index.json
data/out/index.*.json
data/build*.log

# The artifact build of the page; docs/ is the one that gets served
app/dist/

__pycache__/
*.pyc
.DS_Store

# Packaged bundles produced for deployment
*.zip

# Offline bundle built by build/make_usb.py
usb/

# SkyBoT answers for the saved places; build/skybot_saved.py rebuilds docs/sso.json from them
data/skybot_cache.json
